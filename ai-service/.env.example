GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-northeast-2

SQS_REPLY_CHECK_REQUEST_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/{account_id}/nayami-reply-check-request
SQS_REPLY_CHECK_RESULT_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/{account_id}/nayami-reply-check-result
SQS_CONCERN_CHECK_REQUEST_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/{account_id}/nayami-concern-check-request
SQS_CONCERN_CHECK_RESULT_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/{account_id}/nayami-concern-check-result